{
  "name": "dex-visual-layout-sdk",
  "version": "0.1.0",
  "description": "Harness-agnostic agent capability SDK: turn a VisualLayoutSpec into model prompt instructions, detect/parse the generated layout document, and derive the preview security policy from the same spec.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "agent",
    "llm",
    "layout",
    "visual",
    "artifact",
    "prompt-engineering"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
